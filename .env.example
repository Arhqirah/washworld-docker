# Copy this file to .env and fill in real values. Never commit .env itself.

# DATABASE CONNECTIONS
MYSQL_USER=changeme
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=washworld_backend

# PLATFORM (use linux/amd64 on Windows/Intel, linux/arm64 on Apple Silicon)
DOCKER_PLATFORM=linux/amd64

# JWT
SECRET_KEY=changeme

# URLS
BACKEND_URL=http://localhost
FRONTEND_URL=http://localhost:3000

# EMAIL
RESEND_API_KEY=changeme

# FRONTEND (public build-time vars, baked into the client bundle)
NEXT_PUBLIC_API_BASE_URL=http://localhost:80
NEXT_PUBLIC_MAPBOX_TOKEN=changeme
